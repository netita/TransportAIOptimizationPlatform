[Unit]
Description=Discordia AI Operations Platform
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/aneta/ClaudeCode/TransportAIOptimizationPlatform
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300
User=aneta

[Install]
WantedBy=multi-user.target
